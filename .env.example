# TWINTICKER — environment variables
# Copy to .env and fill in. Never commit .env to git.

# OpenAI API key (for the LLM analyzer)
OPENAI_API_KEY=sk-proj-your-key-here

# Optional: override the model (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: port (default: 3000)
PORT=3000

# Optional: log level
LOG_LEVEL=info
